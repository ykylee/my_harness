#!/bin/bash
# myharness — D-135/D-136 overlay wrapper. Engine = installed grok.
set -euo pipefail

MIN_GROK="1.0.3"
GROK_INSTALL_HINT="curl -fsSL https://x.ai/cli/install.sh | bash"
DEFAULT_MODEL="${MYHARNESS_MODEL:-minimax}"

usage() {
  cat <<'EOF'
myharness — grok overlay (3-도메인 래퍼)

Usage:
  myharness                         # grok TUI + this plugin
  myharness code review <target>
  myharness code implement "<feature>"
  myharness code test <path>
  myharness code commit "<message>"
  myharness server status [host]
  myharness server logs <service> [N]
  myharness server deploy <env>
  myharness server config <action>
  myharness env setup <stack>
  myharness env install <pkgs>
  myharness env shell <cmd>
  myharness env diagnose
  myharness task start --id <ID> --title "<title>"
  myharness task end --id <ID> --status done|blocked [--summary s] [--risks r] [--follow-up f]
  myharness setup-model [--print-snippet] [--force]
  myharness --mode=single <args>    # grok -p
  myharness --mode=loop --goal "..." [args]

Flags:
  --help, -h        this help
  --print-cmd       print the grok command and exit (no exec)
  --model <id>      override model (default: minimax / MYHARNESS_MODEL)
  --yes             skip confirm (server deploy)

Requires grok >= 1.0.3 on PATH.
EOF
}

die() {
  echo "myharness: $*" >&2
  exit 2
}

version_ge() {
  # true if $1 >= $2 (semver major.minor.patch, ignore suffix)
  local a b
  a=$(echo "$1" | sed -E 's/[^0-9.].*$//; s/\.$//')
  b=$(echo "$2" | sed -E 's/[^0-9.].*$//; s/\.$//')
  [[ "$(printf '%s\n%s\n' "$b" "$a" | sort -V | tail -n1)" == "$a" ]]
}

find_grok() {
  if [[ -n "${MYHARNESS_GROK:-}" && -x "${MYHARNESS_GROK}" ]]; then
    echo "${MYHARNESS_GROK}"
    return
  fi
  command -v grok 2>/dev/null || true
}

find_plugin_dir() {
  if [[ -n "${MYHARNESS_PLUGIN_DIR:-}" ]]; then
    echo "${MYHARNESS_PLUGIN_DIR}"
    return
  fi
  local src here repo home link
  src="${BASH_SOURCE[0]}"
  if [[ -L "$src" ]]; then
    link="$(readlink "$src")"
    if [[ "$link" == /* ]]; then
      src="$link"
    else
      src="$(cd "$(dirname "$src")" && pwd)/$link"
    fi
  fi
  here="$(cd "$(dirname "$src")" && pwd)"
  repo="$(cd "${here}/.." && pwd)"
  if [[ -f "${repo}/plugins/myharness/plugin.json" ]]; then
    echo "${repo}/plugins/myharness"
    return
  fi
  home="${HOME}/.myharness/plugins/myharness"
  if [[ -f "${home}/plugin.json" ]]; then
    echo "${home}"
    return
  fi
  return 1
}

ensure_engine() {
  local grok ver
  grok="$(find_grok)"
  [[ -n "$grok" ]] || die "grok 이 PATH 에 없습니다. 설치: ${GROK_INSTALL_HINT}"
  ver="$("$grok" --version 2>/dev/null | awk '{print $2}')"
  [[ -n "$ver" ]] || die "grok --version 을 파싱하지 못했습니다"
  version_ge "$ver" "$MIN_GROK" || die "grok ${ver} < 최소 ${MIN_GROK}. 업데이트: grok update"
  GROK_BIN="$grok"
}

prompt_for() {
  local domain="$1" verb="$2"
  shift 2
  case "${domain} ${verb}" in
    "code review") echo "다음 대상을 코드 리뷰하라. 한국어로 결론과 다음 행동만. 대상: $*" ;;
    "code implement") echo "다음 기능을 구현하라. 한국어로 보고. 기능: $*" ;;
    "code test") echo "다음 경로의 테스트를 실행하고 결과를 분석하라. 경로: $*" ;;
    "code commit") echo "다음 메시지로 git commit 을 준비/작성하라. 메시지: $*" ;;
    "server status") echo "서버 상태를 점검하라. 호스트: ${*:-local}" ;;
    "server logs") echo "서비스 로그를 분석하라. 인자: $*" ;;
    "server deploy") echo "배포를 준비하라. 실행 전 확인이 필요하면 멈춰라. 환경: $*" ;;
    "server config") echo "서버 설정을 조회/변경하라. 파괴적 변경은 확인 후. 동작: $*" ;;
    "env setup") echo "다음 스택으로 환경을 부트스트랩하라. 스택: $*" ;;
    "env install") echo "다음 패키지를 설치하라. 패키지: $*" ;;
    "env shell") echo "다음 셸 명령을 실행하고 결과를 분석하라. 명령: $*" ;;
    "env diagnose") echo "현재 개발 환경을 진단하라. uname, PATH 요약, 런타임 버전. 한국어로 결론과 다음 행동만." ;;
    *) return 1 ;;
  esac
}

run_grok() {
  if [[ "$PRINT_CMD" -eq 1 ]]; then
    printf '%q ' "$@"
    echo
    exit 0
  fi
  exec "$@"
}

setup_model() {
  local snippet force=0 print=0 dest="${HOME}/.grok/config.toml"
  local root
  root="${PLUGIN_DIR:-$(find_plugin_dir)}"
  snippet="${root}/examples/minimax.toml"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --print-snippet) print=1; shift ;;
      --force) force=1; shift ;;
      --dest)
        [[ $# -ge 2 ]] || die "--dest 에 값이 필요합니다"
        dest="$2"
        shift 2
        ;;
      *) die "setup-model 알 수 없는 인자: $1" ;;
    esac
  done
  [[ -f "$snippet" ]] || die "snippet 없음: $snippet"
  if [[ "$print" -eq 1 ]]; then
    cat "$snippet"
    exit 0
  fi
  mkdir -p "$(dirname "$dest")"
  if [[ -f "$dest" ]] && grep -q '^\[model\.minimax\]' "$dest" && [[ "$force" -ne 1 ]]; then
    echo "myharness: [model.minimax] 이미 있음 → $dest (덮으려면 --force)"
    exit 0
  fi
  {
    echo ""
    echo "# --- myharness setup-model $(date -Iseconds 2>/dev/null || date) ---"
    cat "$snippet"
  } >>"$dest"
  echo "myharness: MiniMax/Ollama 블록을 추가했습니다 → $dest"
  echo "myharness: export MINIMAX_API_KEY=... 후 ./bin/myharness env diagnose"
}

task_file() {
  echo "${HOME}/.myharness/handoff/tasks/${1}.md"
}

task_cmd() {
  local action="${1:-}"
  shift || true
  local id="" title="" status="done" summary="" risks="" follow=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --id) id="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --status) status="$2"; shift 2 ;;
      --summary) summary="$2"; shift 2 ;;
      --risks) risks="$2"; shift 2 ;;
      --follow-up) follow="$2"; shift 2 ;;
      *) die "task 알 수 없는 인자: $1" ;;
    esac
  done
  [[ -n "$id" ]] || die "task ${action}: --id 가 필요합니다"
  case "$status" in
    planned | in_progress | blocked | done) ;;
    *) die "task status 는 planned|in_progress|blocked|done" ;;
  esac
  mkdir -p "${HOME}/.myharness/handoff/tasks"
  local f now
  f="$(task_file "$id")"
  now="$(date -Iseconds 2>/dev/null || date)"
  case "$action" in
    start)
      [[ -n "$title" ]] || title="$id"
      cat >"$f" <<EOF
# ${id}

- status: in_progress
- title: ${title}
- started_at: ${now}
- summary:
- risks:
- follow_up:
EOF
      echo "myharness: task start → $f"
      ;;
    end)
      [[ -f "$f" ]] || cat >"$f" <<EOF
# ${id}

- status: ${status}
- title: ${id}
- started_at: ${now}
EOF
      # 필드 갱신 (macOS sed)
      local tmp
      tmp="$(mktemp)"
      awk -v st="$status" -v sm="$summary" -v rk="$risks" -v fu="$follow" -v now="$now" '
        BEGIN { done_status=0; done_sum=0; done_rk=0; done_fu=0; done_end=0 }
        /^- status:/ { print "- status: " st; done_status=1; next }
        /^- summary:/ { print "- summary: " sm; done_sum=1; next }
        /^- risks:/ { print "- risks: " rk; done_rk=1; next }
        /^- follow_up:/ { print "- follow_up: " fu; done_fu=1; next }
        /^- ended_at:/ { print "- ended_at: " now; done_end=1; next }
        { print }
        END {
          if (!done_status) print "- status: " st
          if (!done_sum) print "- summary: " sm
          if (!done_rk) print "- risks: " rk
          if (!done_fu) print "- follow_up: " fu
          if (!done_end) print "- ended_at: " now
        }
      ' "$f" >"$tmp"
      mv "$tmp" "$f"
      echo "myharness: task end (${status}) → $f"
      ;;
    *)
      die "task start|end 만 지원"
      ;;
  esac
}

confirm_deploy() {
  if [[ "$YES" -eq 1 ]]; then
    return 0
  fi
  if [[ -t 0 ]]; then
    local ans=""
    read -r -p "server deploy 를 진행할까요? [y/N] " ans || true
    [[ "$ans" == "y" || "$ans" == "Y" ]] || die "배포 취소"
    return 0
  fi
  die "server deploy 는 비대화형에서 --yes 가 필요합니다"
}

PRINT_CMD=0
MODE=""
GOAL=""
MODEL="$DEFAULT_MODEL"
PLUGIN_DIR=""
YES=0

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --print-cmd)
      PRINT_CMD=1
      shift
      ;;
    --model)
      [[ $# -ge 2 ]] || die "--model 에 값이 필요합니다"
      MODEL="$2"
      shift 2
      ;;
    --mode=*)
      MODE="${1#--mode=}"
      shift
      ;;
    --mode)
      [[ $# -ge 2 ]] || die "--mode 에 값이 필요합니다"
      MODE="$2"
      shift 2
      ;;
    --goal)
      [[ $# -ge 2 ]] || die "--goal 에 값이 필요합니다"
      GOAL="$2"
      shift 2
      ;;
    --plugin-dir)
      [[ $# -ge 2 ]] || die "--plugin-dir 에 값이 필요합니다"
      PLUGIN_DIR="$2"
      shift 2
      ;;
    --yes)
      YES=1
      shift
      ;;
    --)
      shift
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

if [[ -z "$PLUGIN_DIR" ]]; then
  PLUGIN_DIR="$(find_plugin_dir)" || die "plugin 을 찾지 못했습니다. MYHARNESS_PLUGIN_DIR 또는 plugins/myharness 를 확인하세요"
fi
[[ -f "${PLUGIN_DIR}/plugin.json" ]] || die "plugin.json 없음: ${PLUGIN_DIR}"

if [[ ${#args[@]} -gt 0 && "${args[0]}" == "setup-model" ]]; then
  setup_model "${args[@]:1}"
  exit 0
fi

if [[ ${#args[@]} -gt 0 && "${args[0]}" == "task" ]]; then
  [[ ${#args[@]} -ge 2 ]] || die "task start|end"
  task_cmd "${args[@]:1}"
  exit 0
fi

ensure_engine

base=("$GROK_BIN" --plugin-dir "$PLUGIN_DIR" -m "$MODEL")

if [[ ${#args[@]} -eq 0 ]]; then
  if [[ "$MODE" == "single" ]]; then
    die "--mode=single 은 프롬프트가 필요합니다"
  fi
  run_grok "${base[@]}"
fi

if [[ ${#args[@]} -ge 2 ]]; then
  domain="${args[0]}"
  verb="${args[1]}"
  rest=("${args[@]:2}")
  if prompt="$(prompt_for "$domain" "$verb" "${rest[@]+"${rest[@]}"}")"; then
    if [[ "${domain} ${verb}" == "server deploy" ]]; then
      confirm_deploy
      export MYHARNESS_ALLOW_DEPLOY=1
    fi
    if [[ -n "$GOAL" || "$MODE" == "loop" ]]; then
      prompt="목표: ${GOAL:-반복 완료까지}. ${prompt}"
    fi
    run_grok "${base[@]}" -p "$prompt"
  fi
fi

# 통과: grok 네이티브 인자
if [[ "$MODE" == "single" && ${#args[@]} -gt 0 ]]; then
  run_grok "${base[@]}" -p "${args[*]}"
fi

run_grok "${base[@]}" "${args[@]}"
