#!/bin/bash
# myharness — D-135/D-136 overlay wrapper. Engine = installed grok.
set -euo pipefail

MIN_GROK="1.0.3"
GROK_INSTALL_HINT="curl -fsSL https://x.ai/cli/install.sh | bash"
DEFAULT_MODEL="${MYHARNESS_MODEL:-minimax}"

usage() {
  cat <<'EOF'
myharness — grok overlay (3-도메인 래퍼)

Usage:
  myharness                         # grok TUI + this plugin
  myharness code review <target>
  myharness code implement "<feature>"
  myharness code test <path>
  myharness code commit "<message>"
  myharness server status [host]
  myharness server logs <service> [N]
  myharness server deploy <env>
  myharness server config <action>
  myharness env setup <stack>
  myharness env install <pkgs>
  myharness env shell <cmd>
  myharness env diagnose
  myharness task start|end ...
  myharness --mode=single <args>    # grok -p
  myharness --mode=loop --goal "..." [args]

Flags:
  --help, -h        this help
  --print-cmd       print the grok command and exit (no exec)
  --model <id>      override model (default: minimax / MYHARNESS_MODEL)

Requires grok >= 1.0.3 on PATH.
EOF
}

die() {
  echo "myharness: $*" >&2
  exit 2
}

version_ge() {
  # true if $1 >= $2 (semver major.minor.patch, ignore suffix)
  local a b
  a=$(echo "$1" | sed -E 's/[^0-9.].*$//; s/\.$//')
  b=$(echo "$2" | sed -E 's/[^0-9.].*$//; s/\.$//')
  [[ "$(printf '%s\n%s\n' "$b" "$a" | sort -V | tail -n1)" == "$a" ]]
}

find_grok() {
  if [[ -n "${MYHARNESS_GROK:-}" && -x "${MYHARNESS_GROK}" ]]; then
    echo "${MYHARNESS_GROK}"
    return
  fi
  command -v grok 2>/dev/null || true
}

find_plugin_dir() {
  if [[ -n "${MYHARNESS_PLUGIN_DIR:-}" ]]; then
    echo "${MYHARNESS_PLUGIN_DIR}"
    return
  fi
  local here repo home
  here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  repo="$(cd "${here}/.." && pwd)"
  if [[ -f "${repo}/plugins/myharness/plugin.json" ]]; then
    echo "${repo}/plugins/myharness"
    return
  fi
  home="${HOME}/.myharness/plugins/myharness"
  if [[ -f "${home}/plugin.json" ]]; then
    echo "${home}"
    return
  fi
  return 1
}

ensure_engine() {
  local grok ver
  grok="$(find_grok)"
  [[ -n "$grok" ]] || die "grok 이 PATH 에 없습니다. 설치: ${GROK_INSTALL_HINT}"
  ver="$("$grok" --version 2>/dev/null | awk '{print $2}')"
  [[ -n "$ver" ]] || die "grok --version 을 파싱하지 못했습니다"
  version_ge "$ver" "$MIN_GROK" || die "grok ${ver} < 최소 ${MIN_GROK}. 업데이트: grok update"
  GROK_BIN="$grok"
}

prompt_for() {
  local domain="$1" verb="$2"
  shift 2
  case "${domain} ${verb}" in
    "code review") echo "다음 대상을 코드 리뷰하라. 한국어로 결론과 다음 행동만. 대상: $*" ;;
    "code implement") echo "다음 기능을 구현하라. 한국어로 보고. 기능: $*" ;;
    "code test") echo "다음 경로의 테스트를 실행하고 결과를 분석하라. 경로: $*" ;;
    "code commit") echo "다음 메시지로 git commit 을 준비/작성하라. 메시지: $*" ;;
    "server status") echo "서버 상태를 점검하라. 호스트: ${*:-local}" ;;
    "server logs") echo "서비스 로그를 분석하라. 인자: $*" ;;
    "server deploy") echo "배포를 준비하라. 실행 전 확인이 필요하면 멈춰라. 환경: $*" ;;
    "server config") echo "서버 설정을 조회/변경하라. 파괴적 변경은 확인 후. 동작: $*" ;;
    "env setup") echo "다음 스택으로 환경을 부트스트랩하라. 스택: $*" ;;
    "env install") echo "다음 패키지를 설치하라. 패키지: $*" ;;
    "env shell") echo "다음 셸 명령을 실행하고 결과를 분석하라. 명령: $*" ;;
    "env diagnose") echo "현재 개발 환경을 진단하라. uname, PATH 요약, 런타임 버전. 한국어로 결론과 다음 행동만." ;;
    *) return 1 ;;
  esac
}

run_grok() {
  if [[ "$PRINT_CMD" -eq 1 ]]; then
    printf '%q ' "$@"
    echo
    exit 0
  fi
  exec "$@"
}

PRINT_CMD=0
MODE=""
GOAL=""
MODEL="$DEFAULT_MODEL"
PLUGIN_DIR=""

args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --print-cmd)
      PRINT_CMD=1
      shift
      ;;
    --model)
      [[ $# -ge 2 ]] || die "--model 에 값이 필요합니다"
      MODEL="$2"
      shift 2
      ;;
    --mode=*)
      MODE="${1#--mode=}"
      shift
      ;;
    --mode)
      [[ $# -ge 2 ]] || die "--mode 에 값이 필요합니다"
      MODE="$2"
      shift 2
      ;;
    --goal)
      [[ $# -ge 2 ]] || die "--goal 에 값이 필요합니다"
      GOAL="$2"
      shift 2
      ;;
    --plugin-dir)
      [[ $# -ge 2 ]] || die "--plugin-dir 에 값이 필요합니다"
      PLUGIN_DIR="$2"
      shift 2
      ;;
    --)
      shift
      args+=("$@")
      break
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

ensure_engine

if [[ -z "$PLUGIN_DIR" ]]; then
  PLUGIN_DIR="$(find_plugin_dir)" || die "plugin 을 찾지 못했습니다. MYHARNESS_PLUGIN_DIR 또는 plugins/myharness 를 확인하세요"
fi
[[ -f "${PLUGIN_DIR}/plugin.json" ]] || die "plugin.json 없음: ${PLUGIN_DIR}"

base=("$GROK_BIN" --plugin-dir "$PLUGIN_DIR" -m "$MODEL")

if [[ ${#args[@]} -eq 0 ]]; then
  if [[ "$MODE" == "single" ]]; then
    die "--mode=single 은 프롬프트가 필요합니다"
  fi
  run_grok "${base[@]}"
fi

if [[ "${args[0]}" == "task" ]]; then
  mkdir -p "${HOME}/.myharness/handoff"
  {
    echo "time=$(date -Iseconds 2>/dev/null || date)"
    echo "args=${args[*]}"
  } >>"${HOME}/.myharness/handoff/tasks.log"
  echo "myharness: task 기록 → ~/.myharness/handoff/tasks.log (M2.4 에서 포맷 확정)"
  exit 0
fi

if [[ ${#args[@]} -ge 2 ]]; then
  domain="${args[0]}"
  verb="${args[1]}"
  rest=("${args[@]:2}")
  if prompt="$(prompt_for "$domain" "$verb" "${rest[@]+"${rest[@]}"}")"; then
    if [[ -n "$GOAL" || "$MODE" == "loop" ]]; then
      prompt="목표: ${GOAL:-반복 완료까지}. ${prompt}"
    fi
    run_grok "${base[@]}" -p "$prompt"
  fi
fi

# 통과: grok 네이티브 인자
if [[ "$MODE" == "single" && ${#args[@]} -gt 0 ]]; then
  run_grok "${base[@]}" -p "${args[*]}"
fi

run_grok "${base[@]}" "${args[@]}"
